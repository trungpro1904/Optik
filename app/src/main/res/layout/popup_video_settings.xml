<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_popup_dark"
    android:padding="12dp">

    <!-- Resolutions -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingEnd="16dp">
        <TextView android:id="@+id/res_4k" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4K" android:textColor="@color/accent_orange" android:padding="8dp" android:textStyle="bold" android:textSize="18sp"/>
        <TextView android:id="@+id/res_hd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HD" android:textColor="@color/accent_orange" android:padding="8dp" android:textStyle="bold" android:textSize="18sp" android:alpha="0.6"/>

        <TextView
            android:id="@+id/res_720"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:padding="8dp"
            android:text="720"
            android:textColor="@color/accent_orange"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#40FFFFFF" />

    <!-- FPS -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp">
        <TextView android:id="@+id/fps_120" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="120" android:textColor="@color/accent_orange" android:padding="8dp" android:textStyle="bold" android:textSize="18sp" android:visibility="gone"/>
        <TextView android:id="@+id/fps_60" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60" android:textColor="@color/accent_orange" android:padding="8dp" android:textStyle="bold" android:textSize="18sp"/>
        <TextView android:id="@+id/fps_30" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30" android:textColor="@color/accent_orange" android:padding="8dp" android:textStyle="bold" android:textSize="18sp" android:alpha="0.6"/>
    </LinearLayout>

</LinearLayout>
