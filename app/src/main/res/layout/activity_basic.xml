<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btn_resolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/resolution_48mp"
            android:textColor="@color/accent_orange"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.461" />

        <TextView
            android:id="@+id/btn_fps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60"
            android:textColor="@color/accent_orange"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/btn_resolution"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/btn_ev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:text="@string/ev"
            android:textColor="@color/accent_orange"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_fps"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.538" />

        <TextView
            android:id="@+id/btn_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mode_basic"
            android:textColor="@color/text_white"
            android:background="@drawable/bg_mode_purple"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:gravity="center"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/btn_ratio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            android:text="@string/ratio_4_3"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_menu"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.461" />

        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_menu"
            app:tint="@color/accent_orange"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Camera Preview Container -->
    <FrameLayout
        android:id="@+id/preview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constrainedWidth="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/panel_container"
        android:clipChildren="true">
        
        <com.example.optik.view.AutoFitTextureView
            android:id="@+id/preview_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
            
        <com.example.optik.view.OverlayView
            android:id="@+id/overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
            
        <include layout="@layout/layout_focus_box" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/exposure_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            app:indicatorSize="120dp"
            app:trackThickness="4dp"
            app:indicatorColor="@color/white"
            app:trackColor="#80000000" />

        <!-- thước dọc-->
        <com.example.optik.view.LevelIndicatorView
            android:id="@+id/level_pitch"
            android:layout_width="60dp"
            android:layout_height="250dp"
            android:layout_marginEnd="32dp"
            android:layout_gravity="end|center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone" />
        <!-- thước ngang -->
        <com.example.optik.view.LevelIndicatorView
            android:id="@+id/level_roll"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="50dp"
            android:visibility="gone" />

        <!-- Preview Blur Overlay -->
        <View
            android:id="@+id/preview_blur_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A0000000"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Zoom Controls -->
    <LinearLayout
        android:id="@+id/lens_selector_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="35dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_lens_selector"
        android:padding="4dp"
        app:layout_constraintBottom_toTopOf="@id/panel_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />>

    <!-- Panels Container -->
    <LinearLayout
        android:id="@+id/panel_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel">

        <!-- EV Slider -->
        <com.example.optik.view.EvSliderView
            android:id="@+id/ev_slider"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#80000000"
            android:visibility="gone" />

        <!-- LUT Slider (Presets) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lut_slider"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:paddingHorizontal="140dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:background="#40000000"
            android:visibility="gone" />

        <!-- Video/Photo Selector -->
        <FrameLayout
            android:id="@+id/video_photo_selector_container"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/gradient_bottom_up"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/video_photo_selector"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_video_mode"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/mode_video"
                    android:textColor="@color/accent_orange"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:alpha="0.5" />

                <TextView
                    android:id="@+id/btn_photo_mode"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/mode_photo"
                    android:textColor="@color/accent_orange"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom Panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/btn_expand"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_expand_more"
            android:rotation="180"
            app:tint="@color/accent_orange"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Album Button -->
        <FrameLayout
            android:id="@+id/btn_album"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/bg_album_rounded"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/album"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/album_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminate="true"
                app:indicatorSize="32dp"
                app:trackThickness="3dp"
                app:indicatorColor="@color/accent_orange" />
        </FrameLayout>

        <!-- Shutter Button Container -->
        <FrameLayout
            android:id="@+id/btn_shutter"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <View
                android:id="@+id/shutter_bg"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_white" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/shutter_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminate="true"
                app:indicatorSize="72dp"
                app:trackThickness="4dp"
                app:indicatorColor="@color/recording_red" />

            <TextView
                android:id="@+id/tv_rec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="REC"
                android:textColor="@color/recording_red"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Flash -->

        <!-- Switch Camera -->
        <ImageView
            android:id="@+id/btn_flash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/circle_border_white"
            android:padding="8dp"
            android:src="@drawable/ic_flash_on"
            app:layout_constraintBottom_toBottomOf="@id/btn_shutter"
            app:layout_constraintEnd_toStartOf="@id/btn_switch"
            app:layout_constraintTop_toTopOf="@id/btn_shutter"
            app:layout_constraintVertical_bias="0.525"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btn_switch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_switch_camera"
            app:tint="@color/accent_orange"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Overlay Wheel (Initially Hidden) -->
    <include layout="@layout/layout_mode_wheel"
        android:id="@+id/mode_wheel_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
