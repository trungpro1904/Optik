<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/manual_settings_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_panel"
    android:visibility="gone"
    android:elevation="0dp">

    <!-- Header: Close Button, Title -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_close_settings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tv_settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="ISO" />
    </RelativeLayout>

    <!-- WB Mode Selector (Only visible when WB is selected) -->
    <LinearLayout
        android:id="@+id/wb_mode_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:weightSum="5">

        <!-- AWB -->
        <LinearLayout
            android:id="@+id/wb_mode_awb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_wb_awb_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="AWB" />
            <TextView
                android:id="@+id/tv_wb_awb_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="10sp"
                android:text="Tự động" />
        </LinearLayout>

        <!-- K1 -->
        <LinearLayout
            android:id="@+id/wb_mode_k1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_wb_k1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="K1" />
            <TextView
                android:id="@+id/tv_wb_k1_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="10sp"
                android:text="N. độ 1" />
        </LinearLayout>

        <!-- K2 -->
        <LinearLayout
            android:id="@+id/wb_mode_k2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_wb_k2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="K2" />
            <TextView
                android:id="@+id/tv_wb_k2_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="10sp"
                android:text="N. độ 2" />
        </LinearLayout>

        <!-- C1 -->
        <LinearLayout
            android:id="@+id/wb_mode_c1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_wb_c1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="C1" />
            <TextView
                android:id="@+id/tv_wb_c1_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="10sp"
                android:text="T. chỉnh 1" />
        </LinearLayout>

        <!-- C2 -->
        <LinearLayout
            android:id="@+id/wb_mode_c2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_wb_c2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="C2" />
            <TextView
                android:id="@+id/tv_wb_c2_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="10sp"
                android:text="T. chỉnh 2" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/settings_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp">

        <!-- Container for Option Groups (Metering, Format, etc.) -->
        <LinearLayout
            android:id="@+id/container_options"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:visibility="gone" />

        <!-- Container for Carousel Picker Values (ISO, Shutter) -->
        <RelativeLayout
            android:id="@+id/picker_container"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_picker"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never" />
                
            <ImageView
                android:id="@+id/btn_picker_left"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:src="@drawable/ic_arrow_left"
                android:scaleType="centerInside"
                android:tint="#888888"
                android:background="?attr/selectableItemBackground" />

            <ImageView
                android:id="@+id/btn_picker_right"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_arrow_right"
                android:scaleType="centerInside"
                android:tint="#888888"
                android:background="?attr/selectableItemBackground" />
                
            <!-- Orange Glow at the bottom of the carousel -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_alignParentBottom="true"
                android:background="@drawable/bg_orange_glow_bottom" />
        </RelativeLayout>

        <!-- Container for Focus Slider (MF) -->
        <LinearLayout
            android:id="@+id/focus_slider_container"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="48dp"
            android:visibility="gone">
            
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/macro_focus"
                android:tint="@color/white" />
                
            <SeekBar
                android:id="@+id/seek_focus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                android:max="1000"
                android:progressDrawable="@drawable/switch_track"
                android:thumb="@drawable/thumb_orange" />
                
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/infinity_focus"
                android:tint="@color/white" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
